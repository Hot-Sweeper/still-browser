{
  "manifest_version": 3,
  "name": "Still",
  "version": "0.1.0",
  "description": "Still's start page, private search, and YouTube experience.",
  "browser_specific_settings": {
    "gecko": {
      "id": "still-prototype@tim.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "156.0"
    }
  },
  "permissions": [
    "history",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "css": [
        "youtube-early.css"
      ],
      "css_origin": "user"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "youtube-early.js",
        "youtube-home.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "youtube-filter.js",
        "youtube-ui.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Manage Still channels"
  },
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:48230 https:; img-src 'self' data: https:"
  }
}
